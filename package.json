{
  "name": "nexcel-solutions-website",
  "version": "1.0.0",
  "description": "Nexcel Solutions — static business-card website (nexcel.kz)",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css --minify",
    "build": "npm run build:css && node scripts/build-site.cjs",
    "dev": "node scripts/dev-server.cjs",
    "dev:cloudflare": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check:http": "node scripts/check-http.cjs",
    "check:responsive": "node scripts/check-responsive.cjs",
    "check:motion": "node scripts/check-motion.cjs",
    "check:roi": "node scripts/check-roi.cjs",
    "check:hero": "node scripts/check-hero.cjs",
    "check:faq": "node scripts/check-faq.cjs",
    "check:cloudflare": "node scripts/check-http.cjs http://127.0.0.1:8787 --cloudflare"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "lucide-static": "^1.38.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "simple-icons": "^16.29.0",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.142.0"
  }
}
