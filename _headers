/*
  Cache-Control: no-store
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://mc.yandex.ru https://yastatic.net https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://mc.yandex.ru https://yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.md/cc https://cloudflareinsights.com; frame-src blob: https://mc.yandex.ru https://mc.yandex.md/metrika/zzlc.html; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Strict-Transport-Security: max-age=31536000

/partials/*
  ! Cache-Control
  X-Robots-Tag: noindex
  Cache-Control: no-store

/shared/nav.json
  ! Cache-Control
  Access-Control-Allow-Origin: https://photo.nexcel.kz
  Cache-Control: public, max-age=300
  Content-Type: application/json; charset=utf-8


/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
